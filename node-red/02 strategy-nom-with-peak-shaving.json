    },
    {
        "id": "bd6709664189abdc",
        "type": "comment",
        "z": "d99b81f8270826b1",
        "g": "a90fc379420bbeff",
        "name": "Start (readme)",
        "info": "# Setting up your battery strategy flow\n\n## Setup\nName the `Link In node` in this start group exactly after the <select> option configured in your\nselect_input.house_battery_strategy\n\nconfigure select options in:\ninput_select_house_battery_control.yaml\n\n### example\n`house_battery_strategy:\n  name: House Battery Strategy\n  options:\n    - AcmE example`\n\nThe above creates a select option, allowing user to select 'AcmE example'\n\nWhen selected, battery control will search for a flow containing a Link In node\ncalled 'AcmE example' (case sensitive).",
        "x": 130,
        "y": 120,
        "wires": []
    },
    {
        "id": "dfb18f1c8a5b43e7",
        "type": "link out",
        "z": "d99b81f8270826b1",
        "g": "a7d3b1401f7dedb4",
        "name": "Return",
        "mode": "return",
        "links": [],
        "x": 915,
        "y": 180,
        "wires": []
    },
    {
        "id": "6e519e50bff028d6",
        "type": "comment",
        "z": "d99b81f8270826b1",
        "g": "a7d3b1401f7dedb4",
        "name": "End (readme)",
        "info": "Should return a solution_array of battery objects\n\n## battery object format\n`{{id: string|number, mode: string, power: number}} battery solution`\n- id is an arbitrary battery ID\n- mode is \"stop\", \"charge\", \"discharge\" for Marstek\n- power in Watts\n\n### example array\nreturn this type of solution_array via msg.solutions\n` \nlet solution_array = [];\nsolution_array.push({id:\"M1\", mode: \"charge\", power: 100}); // per battery\nreturn {solutions: solution_array};\n` ",
        "x": 970,
        "y": 140,
        "wires": []
    },
    {
        "id": "8b5b1cb76a5df24a",
        "type": "debug",
        "z": "d99b81f8270826b1",
        "name": "Reserve %",
        "active": true,
        "tosidebar": false,
        "console": false,
        "tostatus": true,
        "complete": "reserve_percentage",
        "targetType": "msg",
        "statusVal": "reserve_percentage",
        "statusType": "auto",
        "x": 590,
        "y": 100,
        "wires": []
    },
    {
        "id": "logic_function_hysteresis",
        "type": "function",
        "z": "d99b81f8270826b1",
        "g": "b6502b923a53af09",
        "name": "Determine strategy",
        "func": "let current_grid = msg.grid_power || 0;\nlet battery_power = msg.batteries_total_power || 0; // Positief = laden, Negatief = ontladen\nlet max_peak = flow.get('max_peak') || 2.5;\nlet safety_margin = flow.get('safety_margin') || 100;\nlet ev_charging = (flow.get('ev_charging') || 'off') === 'on';\n\nlet peak_limit_watts = (max_peak * 1000) - safety_margin;\nlet reserve_pct = msg.reserve_percentage;\n\nlet is_recharging = flow.get(\"strategy_force_recharge_active\") || false;\n\nlet virtual_grid_power = current_grid - battery_power;\n\nif (reserve_pct < 50) {\n    is_recharging = true; \n} else if (reserve_pct >= 99) {\n    is_recharging = false;\n}\n\nflow.set(\"strategy_force_recharge_active\", is_recharging);\n\nlet target_consumption = 0;\nlet charge_disabled = false;\nlet discharge_disabled = ev_charging; // Standaard is ontladen niet toegestaan wanneer de EV insteekt\nlet status_text = \"\";\nlet status_color = \"green\";\n\nif (is_recharging) {\n    // SCENARIO A: NOODLADEN (Reserve < 50%)\n    // Batterij opladen met maximum piek limiet\n    target_consumption = peak_limit_watts;\n    charge_disabled = false;\n    status_text = \"Recharge reserve\";\n    status_color = \"red\";\n\n} else if (reserve_pct > 99) {\n    // SCENARIO B: BATTERIJ VOL\n    // Maximaal zelfverbruik, nul op de meter\n    target_consumption = 0;\n    charge_disabled = false;\n    status_text = \"Self-consumption\";\n    status_color = \"blue\";\n\n} else {\n    // SCENARIO C: PEAK PROTECTION BUFFER (50% - 99%)\n    // Peak protection, maar buffer mag opgeladen worden bij zonne-overschot\n    if (virtual_grid_power < 250) {\n        // Laag verbruik, mogelijk zonne-overschot dus laden toestaan en ontladen niet\n        target_consumption = 0;\n        charge_disabled = false;\n        discharge_disabled = true;\n        status_text = \"Solar charge\";\n        status_color = \"green\";\n    } else {\n        // Hoger verbruik, peak shaving activeren\n        target_consumption = peak_limit_watts;\n        charge_disabled = true;\n        status_text = \"Peak shaving\";\n        status_color = \"yellow\";\n    }\n}\n\nmsg.house_target_grid_consumption_in_w = target_consumption;\nmsg.target = \"Self-consumption\";\n\nRED.util.setMessageProperty(msg, \"advanced_settings.discharge_disabled\", discharge_disabled, true);\nRED.util.setMessageProperty(msg, \"advanced_settings.charge_disabled\", charge_disabled, true);\n\n// Status update\nnode.status({\n    fill: status_color,\n    shape: \"dot\",\n    text: `${status_text} | Grid: ${Math.round(virtual_grid_power)}W | Target: ${Math.round(target_consumption)}W (charge: ${!charge_disabled}, discharge: ${!discharge_disabled}) at ${new Date().toLocaleString(\"nl-BE\")}`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 180,
        "wires": [
            []
        ]
